<meta name="theme-color" content="#f6efe6">
<style>
:root{--bg:#f6efe6;--bg2:#efe5d6;--ink:#1a1714;--mut:#6f655a;--gold:#b8924a;--gold2:#d9b877;--card:#fffaf2;--r:22px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font-family:-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;overflow-x:hidden}
h1,h2,h3,.logo{font-family:Georgia,"Times New Roman",serif;font-weight:500;letter-spacing:.01em}
a{color:inherit;text-decoration:none}
.wrap{width:min(1120px,100% - 40px);margin:auto}
section{padding:92px 0}
.eyebrow{color:var(--gold);letter-spacing:.28em;text-transform:uppercase;font-size:.74rem;margin-bottom:14px;display:block}
h2{font-size:clamp(2rem,5vw,3.1rem);line-height:1.15;margin-bottom:18px}
.lead{color:var(--mut);max-width:560px}
.center{text-align:center}.center .lead{margin:auto}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 32px;border-radius:50px;font-weight:600;font-size:.95rem;letter-spacing:.04em;border:1px solid var(--gold);cursor:pointer;transition:.35s;background:linear-gradient(135deg,var(--gold),var(--gold2));color:#1a1714;box-shadow:0 10px 28px -10px rgba(184,146,74,.7)}
.btn:hover{transform:translateY(-3px);box-shadow:0 16px 34px -10px rgba(184,146,74,.9)}
.btn.ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.6);box-shadow:none}
.btn.ghost:hover{background:#fff;color:var(--ink)}
header{position:fixed;inset:0 0 auto;z-index:50;transition:.4s;padding:18px 0}
header.sc{background:rgba(246,239,230,.92);backdrop-filter:blur(12px);padding:12px 0;box-shadow:0 4px 24px rgba(0,0,0,.07)}
.nav{display:flex;align-items:center;justify-content:space-between}
.logo{font-size:1.6rem;color:#fff;transition:.4s}.logo b{color:var(--gold2);font-weight:500}
header.sc .logo{color:var(--ink)}
nav ul{display:flex;gap:30px;list-style:none}
nav a{color:#fff;font-size:.9rem;letter-spacing:.06em;transition:.3s;position:relative}
header.sc nav a{color:var(--ink)}
nav a:hover{color:var(--gold)}
.burger{display:none;background:none;border:0;width:32px;height:22px;position:relative;cursor:pointer}
.burger i{position:absolute;left:0;width:100%;height:2px;background:#fff;transition:.3s}
header.sc .burger i{background:var(--ink)}
.burger i:nth-child(1){top:0}.burger i:nth-child(2){top:10px}.burger i:nth-child(3){top:20px}
.burger.on i:nth-child(1){top:10px;transform:rotate(45deg)}.burger.on i:nth-child(2){opacity:0}.burger.on i:nth-child(3){top:10px;transform:rotate(-45deg)}
.hero{min-height:100vh;min-height:100svh;display:flex;align-items:center;color:#fff;position:relative;padding:0;
background:linear-gradient(120deg,rgba(20,16,12,.78),rgba(20,16,12,.38)),url(https://images.unsplash.com/photo-1560066984-138dadb4c035?auto=format&fit=crop&w=1800&q=70) center/cover,linear-gradient(135deg,#2a221a,#6b5230)}
.hero .wrap{padding-top:90px}
.hero h1{font-size:clamp(3rem,10vw,6.4rem);line-height:1;margin:6px 0 22px}
.hero h1 em{color:var(--gold2);font-style:italic}
.hero p{max-width:480px;opacity:.88;font-size:1.08rem;margin-bottom:34px}
.hero .btns{display:flex;gap:14px;flex-wrap:wrap}
.hero>.wrap>*{animation:up 1s both}.hero .wrap>*:nth-child(2){animation-delay:.15s}.hero .wrap>*:nth-child(3){animation-delay:.3s}.hero .wrap>*:nth-child(4){animation-delay:.45s}
@keyframes up{from{opacity:0;transform:translateY(34px)}to{opacity:1;transform:none}}
.scroll{position:absolute;bottom:28px;left:50%;width:1px;height:54px;background:linear-gradient(var(--gold2),transparent);animation:pulse 2s infinite}
@keyframes pulse{50%{opacity:.3}}
.tabs{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:36px 0 34px}
.tab{padding:10px 24px;border-radius:40px;border:1px solid #d9ccb8;background:transparent;cursor:pointer;font-size:.9rem;color:var(--ink);transition:.3s}
.tab.on,.tab:hover{background:var(--ink);color:var(--gold2);border-color:var(--ink)}
.list{max-width:820px;margin:auto;background:var(--card);border-radius:var(--r);padding:12px 34px;box-shadow:0 20px 50px -25px rgba(60,40,10,.35)}
.item{display:flex;align-items:center;gap:16px;padding:20px 0;border-bottom:1px solid #eadfcc}
.item:last-child{border:0}
.item h3{font-size:1.2rem}.item small{display:block;color:var(--mut);font-size:.84rem}
.item .d{flex:1}.price{font-family:Georgia,serif;font-size:1.25rem;color:var(--gold);white-space:nowrap}
.item .go{width:40px;height:40px;border-radius:50%;border:1px solid var(--gold);display:grid;place-items:center;color:var(--gold);transition:.3s;flex:none}
.item .go:hover{background:var(--gold);color:#fff}
.dark{background:var(--ink);color:#f3eadc}.dark .lead{color:#b9ad9c}.dark h2{color:#fff}
.about{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
.pic{aspect-ratio:4/5;border-radius:var(--r);overflow:hidden;position:relative;background:linear-gradient(135deg,#3a2f22,#8a6c3a)}
.pic::after{content:"";position:absolute;inset:14px;border:1px solid rgba(217,184,119,.6);border-radius:14px;pointer-events:none}
.pic img,.g img{width:100%;height:100%;object-fit:cover;display:block;transition:.8s}
.stats{display:flex;gap:34px;margin-top:34px;flex-wrap:wrap}
.stats b{display:block;font-family:Georgia,serif;font-size:2.4rem;color:var(--gold2);font-weight:500;line-height:1.1}
.stats span{font-size:.82rem;color:#b9ad9c}
.gal{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:210px;gap:14px;margin-top:44px}
.g{border-radius:18px;overflow:hidden;background:linear-gradient(135deg,#d8c4a0,#b8924a);position:relative}
.g:nth-child(1),.g:nth-child(6){grid-column:span 2;grid-row:span 2}
.g:hover img,.pic:hover img{transform:scale(1.08)}
.g span{position:absolute;left:16px;bottom:12px;color:#fff;font-size:.85rem;letter-spacing:.08em;text-shadow:0 2px 10px rgba(0,0,0,.6);z-index:2}
.g::after{content:"";position:absolute;inset:0;background:linear-gradient(transparent 55%,rgba(0,0,0,.5))}
.cont{display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:44px}
.box{background:var(--card);border-radius:var(--r);padding:34px;box-shadow:0 20px 50px -28px rgba(60,40,10,.4)}
.box h3{font-size:1.5rem;margin-bottom:18px}
.row{display:flex;justify-content:space-between;padding:10px 0;border-bottom:1px dashed #dccfb8;font-size:.96rem}
.row:last-child{border:0}.row span:last-child{color:var(--mut)}
.row.today{color:var(--gold);font-weight:600}.row.today span:last-child{color:var(--gold)}
.ci{display:flex;gap:14px;margin-bottom:18px;align-items:flex-start}
.ci i{font-style:normal;width:40px;height:40px;border-radius:50%;background:var(--bg2);display:grid;place-items:center;flex:none}
.ci a:hover{color:var(--gold)}.ci small{color:var(--mut);display:block;font-size:.8rem}
.mx{background:#007aff;border-color:#007aff;color:#fff;width:100%;margin-top:6px;box-shadow:0 10px 28px -10px rgba(0,122,255,.7)}
footer{background:var(--ink);color:#9b8f7e;text-align:center;padding:34px 0;font-size:.85rem}
footer .logo{color:#fff;font-size:1.4rem;display:block;margin-bottom:6px}
.fab{position:fixed;right:18px;bottom:18px;z-index:60;width:58px;height:58px;border-radius:50%;background:#007aff;display:grid;place-items:center;box-shadow:0 10px 26px rgba(0,122,255,.55);transition:.3s}
.fab:hover{transform:scale(1.1)}
.fab svg{width:28px;height:28px;fill:#fff}
.rv{opacity:0;transform:translateY(36px);transition:opacity .9s,transform .9s}.rv.in{opacity:1;transform:none}
@media(max-width:860px){
section{padding:68px 0}
.burger{display:block}
nav{position:fixed;inset:0 0 0 auto;width:min(300px,80%);background:var(--ink);padding:90px 34px;transform:translateX(100%);transition:.4s}
nav.open{transform:none}
nav ul{flex-direction:column;gap:22px}nav a,header.sc nav a{color:#f3eadc;font-size:1.05rem}
.burger{z-index:70}.burger.on i{background:#fff!important}
.about,.cont{grid-template-columns:1fr;gap:34px}
.pic{aspect-ratio:4/3}
.gal{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}
.g:nth-child(1),.g:nth-child(6){grid-column:span 2;grid-row:span 1}
.list{padding:6px 20px}.item{gap:12px}.item .go{display:none}
.box{padding:26px}
}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}
</style>
</head>
<body>

