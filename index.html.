<svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
</a>

<script>
const PHONE="79000000000";
const maxLink = t => "https://max.ru/:share?text=" + encodeURIComponent(t);
const S={
"Волосы":[["Женская стрижка","укладка в подарок",3500],["Окрашивание","один тон, до 40 см",7500],["Сложное окрашивание","airtouch, balayage",12000],["Уход Olaplex","восстановление структуры",4000]],
"Ногти":[["Классический маникюр","с покрытием гель-лак",2800],["Педикюр","с покрытием гель-лак",3500],["Наращивание","форма и дизайн на выбор",4500]],
"Лицо":[["Чистка лица","ультразвук + пилинг",4500],["Увлажняющий уход","с массажем лица",5500],["Брови и ресницы","коррекция и окрашивание",2500]],
"Макияж":[["Дневной макияж","натуральный образ",4000],["Вечерний макияж","стойкий, с ресницами",6000],["Свадебный образ","макияж и пробная встреча",12000]]
};
const fmt=n=>n.toLocaleString("ru-RU")+" ₽";
const tabs=document.getElementById("tabs"),list=document.getElementById("list");
function show(k){
 [...tabs.children].forEach(b=>b.classList.toggle("on",b.textContent===k));
 list.innerHTML=S[k].map(s=>`<div class="item"><div class="d"><h3>${s[0]}</h3><small>${s[1]}</small></div><div class="price">${fmt(s[2])}</div><a class="go" target="_blank" rel="noopener" href="${maxLink("Здравствуйте! Хочу записаться на услугу: "+s[0]+" ("+fmt(s[2])+").")}">→</a></div>`).join("");
}
Object.keys(S).forEach(k=>{const b=document.createElement("button");b.className="tab";b.textContent=k;b.onclick=()=>show(k);tabs.appendChild(b)});
show("Волосы");

const H=[["Понедельник","10:00 – 21:00"],["Вторник","10:00 – 21:00"],["Среда","10:00 – 21:00"],["Четверг","10:00 – 21:00"],["Пятница","10:00 – 21:00"],["Суббота","10:00 – 20:00"],["Воскресенье","11:00 – 18:00"]];
const td=(new Date().getDay()+6)%7;
document.getElementById("hours").innerHTML=H.map((h,i)=>`<div class="row${i===td?" today":""}"><span>${h[0]}</span><span>${h[1]}</span></div>`).join("");

document.querySelectorAll(".mxm").forEach(a=>{a.href=maxLink(a.dataset.t);a.target="_blank";a.rel="noopener"});
document.getElementById("yr").textContent=new Date().getFullYear();

const hd=document.getElementById("hd"),nv=document.getElementById("nv"),bg=document.getElementById("bg");
const sc=()=>hd.classList.toggle("sc",scrollY>50);sc();addEventListener("scroll",sc,{passive:true});
bg.onclick=()=>{nv.classList.toggle("open");bg.classList.toggle("on")};
nv.querySelectorAll("a").forEach(a=>a.onclick=()=>{nv.classList.remove("open");bg.classList.remove("on")});

const io=new IntersectionObserver(e=>e.forEach(x=>{
    x.target.classList.toggle("in", x.isIntersecting);
}),{threshold:.12});
document.querySelectorAll(".rv").forEach(el=>io.observe(el));
</script>
